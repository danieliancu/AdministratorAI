# Copy to .env and replace every change-me value. .env is never committed.
# Compose passes each service only the variables it needs: the owner and
# superuser passwords never reach the web or worker containers.

DJANGO_SECRET_KEY=change-me

POSTGRES_SUPERUSER_PASSWORD=change-me
AAI_OWNER_PASSWORD=change-me
AAI_APP_PASSWORD=change-me
AAI_PLATFORM_PASSWORD=change-me
AAI_LEGAL_PASSWORD=change-me

# Optional until a real AI provider is used. Only the worker receives it.
OPENAI_API_KEY=
